{
  "name": "kafedra-week5",
  "private": true,
  "packageManager": "npm@11.6.0",
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace backend",
    "dev:web": "npm run dev --workspace frontend",
    "build:api": "npm run build --workspace backend",
    "build:web": "npm run build --workspace frontend",
    "build": "npm run build --workspaces --if-present",
    "composer:deploy": "npm run composer:deploy --workspace backend",
    "dev:composer": "npm run dev:composer --workspace backend",
    "docker:prod": "docker compose up --build",
    "docker:dev": "docker compose -f docker-compose.yml -f docker-compose.dev.yml up --build",
    "docker:down": "docker compose down",
    "docker:reset": "docker compose down -v"
  },
  "overrides": {
    "effect": "4.0.0-rc.115",
    "@effect/platform-bun": "4.0.0-rc.115",
    "@effect/platform-node": "4.0.0-rc.115",
    "@effect/platform-node-shared": "4.0.0-rc.115",
    "@effect/sql-d1": "4.0.0-rc.115",
    "@effect/sql-sqlite-do": "4.0.0-rc.115",
    "@effect/vitest": "4.0.0-rc.115"
  }
}
