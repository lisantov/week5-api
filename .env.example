# Copy to `.env` and adjust if needed: `cp .env.example .env`
# Docker Compose reads this file for the ${VARIABLES} used in the compose files.

# --- Edge nginx ---
HTTP_PORT=80

# --- PostgreSQL ---
POSTGRES_USER=kafedra
POSTGRES_PASSWORD=kafedra
POSTGRES_DB=kafedra
POSTGRES_PORT=5432

# --- pgAdmin ---
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin
PGADMIN_PORT=5050

# --- Dev only: directly published app ports (docker-compose.dev.yml) ---
BACKEND_PORT=3000
FRONTEND_PORT=5173
